# Copy to .env and fill in. Never commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=
# Latest Haiku for speed. Override if needed.
ANTHROPIC_MODEL=claude-haiku-5-5
# Hard per-attempt timeout in seconds.
LLM_TIMEOUT_S=15

# --- Facebook webhook ---
# App secret used to verify X-Hub-Signature-256. simulate.py signs with the same value.
FB_APP_SECRET=
# Any string; must match what you enter in the Facebook webhook subscription.
FB_VERIFY_TOKEN=

# --- Google Sheet (Apps Script web app) ---
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Same value as the SHEETS_TOKEN script property in Apps Script.
SHEETS_TOKEN=

# --- Alerts ---
# discord (default) or slack
NOTIFIER=discord
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Reply drafts ---
BOOKING_URL=https://cal.com/your-handle/15min

# --- Optional ---
# Base URL for simulate.py / bench.py (e.g. your ngrok URL)
# WEBHOOK_BASE_URL=http://127.0.0.1:8000
# Mock individual pieces: MOCK=1 mocks everything; or MOCK_LLM / MOCK_SHEET / MOCK_NOTIFY
# MOCK_SHEET=1
# Turn off /demo when exposing the server publicly
# DEMO_ENABLED=true
